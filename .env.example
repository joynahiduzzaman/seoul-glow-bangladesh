# ==========================================================
# SEOUL GLOW BANGLADESH — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in real values before deploying.
# The app runs out-of-the-box on the SQLite defaults below.
# ==========================================================

# --- Database ---
# prisma/schema.prisma declares provider = "postgresql", so DATABASE_URL must be a
# postgres:// URL. A SQLite "file:" URL will fail immediately with a provider
# mismatch — if you genuinely want a different engine, change the provider in the
# schema first.
#
# Local: install Postgres, or point at a free Neon branch (neon.tech).
DATABASE_URL="postgresql://user:password@localhost:5432/seoul_glow"

# Direct, non-pooled connection used only by Prisma Migrate. Managed Postgres
# providers front the database with a connection pooler (Neon uses PgBouncer),
# which does not support the session-level operations migrations need. On Neon
# this is the same URL with "-pooler" removed from the hostname. Locally, where
# there is no pooler, set it to the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/seoul_glow"

# --- Auth / JWT ---
JWT_SECRET="change-this-to-a-long-random-string"
JWT_REFRESH_SECRET="change-this-to-a-different-long-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# --- Social login (Google / Facebook) ---
# Leave blank to keep the "Continue with Google/Facebook" buttons on the login and
# register pages disabled (they'll show a friendly "not connected yet" message
# instead of crashing). To enable:
#   Google:   console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
#             Authorized redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
#   Facebook: developers.facebook.com -> your app -> Facebook Login -> Settings
#             Valid OAuth Redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/facebook/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# --- Site ---
# The public origin, no trailing slash. Everything canonical derives from this:
# metadataBase, Open Graph URLs, sitemap.xml, robots.txt, links in transactional
# emails, and the payment gateways' success/fail callback URLs.
#
# Local development keeps localhost below. In production set it to the stable
# domain, NOT a per-deployment URL — Vercel's ...-<hash>-<team>.vercel.app names
# are frozen to one build, so canonical tags built from them would point search
# engines at an old deployment after the next push.
#
#   Production: NEXT_PUBLIC_SITE_URL="https://seoulglowbangladesh.com"
#
# If this is unset, the app falls back to Vercel's production domain and only
# then to localhost — see src/lib/site-url.ts.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Seoul Glow Bangladesh"

# --- Bangladesh Payment Gateways (modular — leave blank to keep COD-only) ---
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_BASE_URL="https://tokenized.pay.bka.sh/v1.2.0-beta"

NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_PRIVATE_KEY=""
NAGAD_PG_PUBLIC_KEY=""
NAGAD_BASE_URL="https://api.mynagad.com/api/dfs"

SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_LIVE="false"

SHURJOPAY_USERNAME=""
SHURJOPAY_PASSWORD=""
SHURJOPAY_PREFIX=""
SHURJOPAY_BASE_URL="https://sandbox.shurjopayment.com"

STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""

# --- Contact / Social (shown in footer + floating buttons) ---
NEXT_PUBLIC_WHATSAPP_NUMBER="8801319453920"
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/seoulglowbangladesh/"
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/seoulglowbangladesh/"
NEXT_PUBLIC_SUPPORT_EMAIL="seoulglow26@gmail.com"


# --- Affiliate / Referral Program ---
AFFILIATE_COMMISSION_PERCENT="10"

# --- Cron / Automation ---
# Shared secret required to call /api/cron/* endpoints (abandoned cart emails). Set this,
# then point an external scheduler (Vercel Cron, cron-job.org, GitHub Actions) at those routes
# with header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="change-this-to-a-long-random-string"

# --- Live Chat ---
NEXT_PUBLIC_FACEBOOK_PAGE_ID=""

# --- Cloudinary (product image uploads) ---
# Required in production: serverless hosting has a read-only filesystem, so
# uploads cannot be written to /public. Leave blank locally and uploads fall
# back to public/uploads/products. See README > Image uploads (Cloudinary).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Email (Resend) ---
# Transactional email is sent through Resend (https://resend.com), not SMTP.
# Leave RESEND_API_KEY blank locally and emails are logged to the console instead
# of being sent, so the app works on a fresh clone with no mail account.
# See README > Transactional email (Resend).
RESEND_API_KEY=""
# Verified sender. Defaults to Resend's shared onboarding@resend.dev, which can
# only deliver to the address that owns the Resend account. Set this to an
# address on your own verified domain to email real customers.
EMAIL_FROM=""

# --- Courier integrations (optional) ---
# Each courier is independent and inert until its credentials are present: the
# admin order screen falls back to entering a tracking number by hand, so leaving
# these blank costs a convenience, not a capability.
PAPERFLY_MERCHANT_CODE=""
PAPERFLY_API_KEY=""
PATHAO_CLIENT_ID=""
PATHAO_CLIENT_SECRET=""
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
REDX_API_TOKEN=""

# --- SMS order notifications (optional) ---
# Without this, order status changes notify by email only.
SMS_PROVIDER_API_KEY=""

# --- Instagram feed (optional) ---
# The homepage Instagram grid shows real posts when these are set, and a link to
# the profile otherwise — it never falls back to stock photography.
#
# Requires the Instagram GRAPH API: a Business or Creator account linked to a
# Facebook Page, inside a Meta app that has cleared review. The old Basic
# Display API, which worked with a personal account, was shut down on
# 4 December 2024. See README > Instagram feed.
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_USER_ID=""
