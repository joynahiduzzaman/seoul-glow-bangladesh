# ==========================================================
# SEOUL GLOW BANGLADESH — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in real values before deploying.
# The app runs out-of-the-box on the SQLite defaults below.
# ==========================================================

# --- Database ---
# Default (zero-config, works instantly on your laptop):
DATABASE_URL="file:./dev.db"
# MySQL example:      DATABASE_URL="mysql://user:password@localhost:3306/seoul_glow"
# PostgreSQL example: DATABASE_URL="postgresql://user:password@localhost:5432/seoul_glow"
# MariaDB example:    DATABASE_URL="mysql://user:password@localhost:3306/seoul_glow"
# SQL Server example:  DATABASE_URL="sqlserver://localhost:1433;database=seoul_glow;user=sa;password=yourpassword"
# NOTE: if you switch, also change `provider` at the top of prisma/schema.prisma to match.

# --- Auth / JWT ---
JWT_SECRET="change-this-to-a-long-random-string"
JWT_REFRESH_SECRET="change-this-to-a-different-long-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# --- Social login (Google / Facebook) ---
# Leave blank to keep the "Continue with Google/Facebook" buttons on the login and
# register pages disabled (they'll show a friendly "not connected yet" message
# instead of crashing). To enable:
#   Google:   console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
#             Authorized redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
#   Facebook: developers.facebook.com -> your app -> Facebook Login -> Settings
#             Valid OAuth Redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/facebook/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# --- Site ---
# The public origin, no trailing slash. Everything canonical derives from this:
# metadataBase, Open Graph URLs, sitemap.xml, robots.txt, links in transactional
# emails, and the payment gateways' success/fail callback URLs.
#
# Local development keeps localhost below. In production set it to the stable
# domain, NOT a per-deployment URL — Vercel's ...-<hash>-<team>.vercel.app names
# are frozen to one build, so canonical tags built from them would point search
# engines at an old deployment after the next push.
#
#   Production: NEXT_PUBLIC_SITE_URL="https://seoul-glow-bangladesh.vercel.app"
#
# If this is unset, the app falls back to Vercel's production domain and only
# then to localhost — see src/lib/site-url.ts.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Seoul Glow Bangladesh"

# --- Bangladesh Payment Gateways (modular — leave blank to keep COD-only) ---
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_BASE_URL="https://tokenized.pay.bka.sh/v1.2.0-beta"

NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_PRIVATE_KEY=""
NAGAD_PG_PUBLIC_KEY=""
NAGAD_BASE_URL="https://api.mynagad.com/api/dfs"

SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_LIVE="false"

SHURJOPAY_USERNAME=""
SHURJOPAY_PASSWORD=""
SHURJOPAY_PREFIX=""
SHURJOPAY_BASE_URL="https://sandbox.shurjopayment.com"

STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""

# --- Contact / Social (shown in footer + floating buttons) ---
NEXT_PUBLIC_WHATSAPP_NUMBER="8801319453920"
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/seoulglowbangladesh/"
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/seoulglowbangladesh/"
NEXT_PUBLIC_SUPPORT_EMAIL="seoulglow26@gmail.com"

# --- Email (SMTP — works with Gmail, SendGrid, Mailgun, SES, Zoho, or your own server) ---
# Leave SMTP_HOST blank to keep emails "logged, not sent" during local development.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="\"Seoul Glow Bangladesh\" <seoulglow26@gmail.com>"

# --- Affiliate / Referral Program ---
AFFILIATE_COMMISSION_PERCENT="10"

# --- Cron / Automation ---
# Shared secret required to call /api/cron/* endpoints (abandoned cart emails). Set this,
# then point an external scheduler (Vercel Cron, cron-job.org, GitHub Actions) at those routes
# with header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="change-this-to-a-long-random-string"

# --- Live Chat ---
NEXT_PUBLIC_FACEBOOK_PAGE_ID=""
