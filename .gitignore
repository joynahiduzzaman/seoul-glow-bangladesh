node_modules
.next
out
build
dist
.env
.env.local
.env*.local
*.db
*.db-journal
dev.db
prisma/dev.db

# Database snapshots taken before migrations. These are full copies of the
# database with real customer data, and the .bak suffix means the *.db rule
# above does not cover them.
backups/
*.bak
*.sqlite
*.sqlite3
*.dump
.DS_Store
npm-debug.log*

# Admin-uploaded product images — user-generated content, not source. The folder
# structure is preserved via public/uploads/products/.gitkeep.
public/uploads/*
!public/uploads/products
public/uploads/products/*
!public/uploads/products/.gitkeep

# Ad-hoc verification scripts kept out of the repo.
.verify-*.mjs
.prod-*.mjs
.audit-*.mjs
.test-*.mjs
.mkimg.mjs
.imgs/

# Scratch credentials used while driving the app in a browser during testing.
# These held a real admin password and a signed session cookie, and neither was
# covered by any rule above — a `git add -A` would have committed both.
.tpw
.session.json

# TypeScript incremental build cache — a build artifact, not source.
tsconfig.tsbuildinfo
